{
    "extends": "@react-native/typescript-config/tsconfig.json",
    "compilerOptions": {
        "ignoreDeprecations": "6.0",
        "skipLibCheck": true,
        "strict": true,
        "baseUrl": ".",
        "paths": { "@/*": ["./*"] },
        "types": []
    },
    "include": [
        "**/*.ts",
        "**/*.tsx",
        ".expo/types/**/*.ts",
        "expo-env.d.ts",
        "nativewind-env.d.ts"
    ],
    "exclude": ["node_modules"]
}
