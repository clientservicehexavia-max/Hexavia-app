{
    "cli": {
        "version": ">= 18.3.0",
        "appVersionSource": "remote"
    },
    "build": {
        "development": {
            "developmentClient": true,
            "distribution": "internal",
            "channel": "development",
            "env": {
                "APP_VARIANT": "development"
            },
            "android": {
                "buildType": "apk"
            },
            "ios": {
                "simulator": true
            }
        },
        "preview": {
            "distribution": "internal",
            "channel": "preview",
            "env": {
                "APP_VARIANT": "preview"
            },
            "android": {
                "buildType": "apk"
            }
        },
        "production": {
            "autoIncrement": true,
            "channel": "production",
            "env": {
                "APP_VARIANT": "production"
            },
            "android": {
                "gradleCommand": ":app:bundleRelease"
            }
        }
    },
    "submit": {
        "production": {
            "android": {
                "track": "internal"
            }
        }
    }
}
